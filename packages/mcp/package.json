{
  "name": "@daymaker/mcp",
  "version": "0.4.1",
  "description": "Local MCP server (stdio) with one tool per Daymaker API operation.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daymaker-hq/daymaker-for-agents.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://daymaker.com",
  "bugs": "https://github.com/daymaker-hq/daymaker-for-agents/issues",
  "publishConfig": {
