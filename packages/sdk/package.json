{
  "name": "@daymaker/sdk",
  "version": "0.4.1",
  "description": "Typed client for the Daymaker API (https://daymaker.com/api/v2).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daymaker-hq/daymaker-for-agents.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://daymaker.com",
  "bugs": "https://github.com/daymaker-hq/daymaker-for-agents/issues",
