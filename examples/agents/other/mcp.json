{
  "mcpServers": {
    "daymaker": {
      "type": "http",
      "url": "https://daymaker.com/mcp"
    },
    "daymaker-api": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@daymaker/mcp"
      ],
      "env": {
        "DAYMAKER_KEY": "${DAYMAKER_KEY}"
      }
    }
  }
}
