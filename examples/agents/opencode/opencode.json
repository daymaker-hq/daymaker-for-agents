{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "daymaker": {
      "type": "remote",
      "url": "https://daymaker.com/mcp",
      "enabled": true
    },
    "daymaker-api": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@daymaker/mcp"
      ],
      "environment": {
        "DAYMAKER_KEY": "{env:DAYMAKER_KEY}"
      },
      "enabled": false
    }
  }
}
